<?xml version="1.0" encoding="utf-8"?>
<!-- The directory holding the device id (DEVICE_ID_DIR) stays out of cloud backup and out of a device-to-device
     transfer (R59): a restored or transferred phone must not be a second copy of this one. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="identity" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="identity" />
    </device-transfer>
</data-extraction-rules>
