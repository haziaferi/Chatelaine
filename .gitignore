*.jks
*.keystore
keystore.properties
signing.properties
google-services.json
.env
*.env

# Device runs: screenshots, logs and per-phone state stay local
walk/
device-logs/
screenshots/
*.logcat
logcat*.txt

# Downloaded on-device models (large; fetched at runtime, never committed)
models/
*.gguf
*.tflite
*.onnx

# Gradle build logs
build-logs/
